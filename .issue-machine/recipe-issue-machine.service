[Unit]
Description=Recipe issue machine
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nate/Desktop/recipe-issue-machine
Environment=HOME=/home/nate
Environment=TERM=xterm-256color
Environment=PATH=/home/nate/.local/bin:/home/nate/.cargo/bin:/usr/local/bin:/usr/bin:/opt/rocm/bin
ExecStart=/usr/bin/tmux -S /tmp/tmux-%U/default -D -f /home/nate/Desktop/recipe-issue-machine/.issue-machine/tmux.conf
ExecStop=/usr/bin/tmux kill-session -t recipe-issue-machine
KillMode=control-group
Restart=always
RestartSec=1
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
