[Unit]
Description=Recipe issue machine
Wants=network-online.target
After=network-online.target

[Service]
Type=forking
WorkingDirectory=/home/nate/Desktop/recipe-issue-machine
Environment=HOME=/home/nate
Environment=TERM=xterm-256color
Environment=PATH=/home/nate/.local/bin:/home/nate/.cargo/bin:/usr/local/bin:/usr/bin:/opt/rocm/bin
ExecStartPre=/usr/bin/rm -f /tmp/tmux-%U/default /tmp/tmux-%U/default.lock
ExecStart=/usr/bin/tmux -S /tmp/tmux-%U/default -f /home/nate/Desktop/recipe-issue-machine/.issue-machine/tmux.conf new-session -d -s recipe-issue-machine /home/nate/Desktop/recipe-issue-machine/.issue-machine/session
ExecStop=/usr/bin/tmux -S /tmp/tmux-%U/default kill-server
ExecStopPost=/usr/bin/rm -f /tmp/tmux-%U/default /tmp/tmux-%U/default.lock
KillMode=control-group
Restart=always
RestartSec=1
StandardOutput=null
StandardError=append:/home/nate/Desktop/recipe-issue-machine/recipe.log

[Install]
WantedBy=default.target
