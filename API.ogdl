recipe
	.data(sources)
		.set(source)
		.target(targets)
		.exclude(exclusions)
		.norm(z_score)
		.norm(min_max)
		.norm(l2_norm)
		.split(train_fraction)
	.model()
		.load(path)
		.bayes(child, [parents])
		.perc(count)
		.layer(neurons)
		.conv(filters, kernel)
		.pool(size)
			.layer(neurons)
		.kmeans(clusters)
			.layer(neurons)
		.knn(neighbors)
		.residual(layer(neurons), relu(), ...)
		.lgbm(depth)
		.cbst(depth)
		.xgbst(depth)
		.forest(trees)
			.lgbm(depth)
			.cbst(depth)
			.xgbst(depth)
		.embed(dimensions)
			.vocab(vocabulary)
		.attn(heads)
		.rnn(width)
		.gru(width)
		.lstm(width)
		.norm(layer_norm)
		.norm(batch_norm)
		.relu()
		.leak()
		.sigmoid()
		.tanh()
		.tan()
		.selu()
		.gelu()
		.silu()
		.elu()
		.prelu()
		.cos()
		.exp()
		.log()
		.ln()
		.huber()
		.loss(bce)
		.loss(mse)
		.loss(mae)
		.loss(ce)
		.loss(huber)
		.loss(focal)
		.grad(clip: maximum_norm)
	.train()
		.optimizer(adamw)
		.epochs(count)
		.lr(rate)
			.cos()
			.exp()
		.warmup(count)
		.log(Loss)
		.log(Accuracy)
		.log(R2)
		.log(AuRoc)
		.log(AuPrc)
		.log(Brier)
		.log(CalibrationError)
		.log(Epoch)
		.log(Lr)
		.log(Time)
		.log(Device)
		.log([items])
		.log([items]).every(interval)
		.plot([items])
		.resume("model.ogdl")
		.resume("model.ogdl", "kernel.cubin")
		.resume("model.ogdl", "kernel.hsaco")
		.save("model.ogdl")
		.save("kernel.cubin")
		.save("kernel.hsaco")
		.save("model.ogdl", "kernel.cubin")
		.save("model.ogdl", "kernel.hsaco")
		.run()
	.infer()
		.load("model.ogdl" OR "model.gguf")
		.log(item)
		.log([items])
		.evaluate()
