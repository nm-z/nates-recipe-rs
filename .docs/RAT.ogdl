rm	register tile M
rn	register tile N
rdfk	reduction fragment K
rdck	reduction chunk K
kpl	split-K partition limit
kvs	split-K vector span
kms	split-K matrix span
wvmd	wave mode	opt in [1, 2, 4, 8, 16, 32, 64, 128]
swz	swizzle width
cu	CU count
sd	SIMD count
lds	LDS size
wv	waves
wg	workgroups
gd	grid dimensions	= 3
sdpcu	sd/cu
wpwg	wv/wg
wgx	wg x-dim
wgy	wg y-dim
wgz	wg z-dim
t	threads
tpwv	t/wv
tpwg	t/wg
tpwgx	t/wgx
tpwgy	t/wgy
tpwgz	t/wgz
mtpwg		max tpwg
mtpwgx	max tpwg X
mtpwgy	max tpwg Y
mtpwgz	max tpwg Z
mwvpcu	max wv/cu
mwvpsd	max wv/sd
g	grid volume
gx	x-dim threads
gy	y-dim threads
gz	z-dim threads
gms		max g
gmx		max gx
gmy		max gy
gmz		max gz

model_bytes	bytes/model value
state_ratio	ceil(accumulator bytes/model_bytes)

constrain
	g <= gms
	gx <= gmx
	gy <= gmy
	gz <= gmz
	tpwg	<=	mtpwg
	tpwgx	<=	mtpwgx
	tpwgy	<=	mtpwgy
	tpwgz	<=	mtpwgz
	tpwgx <= gx
	tpwgy <= gy
	tpwgz <= gz
	wvmd
		wave32
			tpwv = 32
		wave64
			tpwv = 64
	wv = wg × wpwg
	wg = wgx × wgy × wgz
	wg <= ceil(M / m) × ceil(N / n)
	t = g
	g = gx × gy × gz
	tpwg = tpwgx × tpwgy × tpwgz
	(wpwg - 1) × tpwv < tpwg <= wpwg × tpwv
	(wgx - 1) × tpwgx < gx <= wgx × tpwgx
	(wgy - 1) × tpwgy < gy <= wgy × tpwgy
	(wgz - 1) × tpwgz < gz <= wgz × tpwgz
	rdck % rdfk = 0
	contraction
		vector
			(m + n) × k × model_bytes <= lds
			k > rdck
				ceil(k / rdck) × min(ceil(m / rm) × ceil(n / rn), floor(tpwg / 2)) × min(rm, m) × min(rn, n) × state_ratio × model_bytes <= lds
		matrix
			(m + n) × k × model_bytes <= lds
	reasonable
		m <= M
		n <= N
		k <= K
query
	wvmd
	cu
	sdpcu
	lds
	gms
	gmx
	gmy
	gmz
	mwvpcu
	mtpwg
	mtpwgx
	mtpwgy
	mtpwgz
	M
	N
	K
predict
	wvmd	categorical
	tpwgx	int in [1, mtpwgx]
	tpwgy	int in [1, mtpwgy]
	tpwgz	int in [1, mtpwgz]
	swz	int in [1, M)
	gx	int in [1, gmx]
	gy	int in [1, gmy]
	gz	int in [1, gmz]
	tile
		m	int in [1, M]
		n	int in [1, N]
		k	int in [1, K]
	register tile
		rm	int in [1, M]
		rn	int in [1, N]
	reduction
		fragment
			rdfk	int in [1, K]
		chunk
			rdck	int in [1, K]
	split-K
		partition limit
			kpl	int in [1, K]
		vector span
			kvs	int in [1, K]
		matrix span
			kms	int in [1, K]
derive
	model_bytes = sizeof(model arithmetic)
	state_ratio = ceil(sizeof(accumulator arithmetic) / model_bytes)
	sd = cu × sdpcu
	mwvpsd = mwvpcu / sdpcu
	tpwv = wvmd
	tpwg = tpwgx × tpwgy × tpwgz
	wpwg = ceil(tpwg / tpwv)
	wgx = ceil(gx / tpwgx)
	wgy = ceil(gy / tpwgy)
	wgz = ceil(gz / tpwgz)
	wg = wgx × wgy × wgz
	g = gx × gy × gz
	t = g
	wv = wg × wpwg

queried = query()
bench_model.create()
knob_model.create()

if bench_model.weights.absent && knob_model.weights.absent {
	loads = coupled_load_space(
		budget = min(query(free_vram), rat.vram_budget_bytes)
		M = rat.load_steps levels
		N = rat.load_steps levels
		K = rat.load_steps levels
		bytes(M × K + K × N + M × N + N) <= budget
	)
	configs = truth_table(loads, search_space(queried, constrain))
	require(minimum_csv_bytes(configs) <= query(free_disk))

	for config in configs {
		time = measure(config.query, config.knobs)
		if invalid(time) {
			time = invalid_time
		}
		csv.write(time, config.query.M, config.query.N, config.query.K, config.knobs)
	}

	for epoch in 10 {
		for row in csv {
			bench_model.epoch(
				input = row.queried + row.knobs
				target = row.time
			)
		}
	}

	bench_model.save()
	knob_model.save()
}

for shuffle in 10 {
	shuffle(knobs)
	chosen = []
	ss = search_space(queried, constrain, chosen)

	while chosen.len() < knobs.len() {
		while knob = ss.next_singleton(knobs, chosen) {
			chosen.add(knob, derive(ss.options(knob)))
			ss = ss.update(chosen)
		}

		knob = ss.next_unresolved(knobs, chosen)
		chosen.add(
			knob,
			knob_model.predict(queried, chosen, ss.options(knob))
		)
		ss = ss.update(chosen)
	}

	time = knob_model.epoch(
		input = queried,
		target = 0,
		through = bench_model,
		config = chosen
	)

	if invalid(time) {
		time = invalid_time
	}

	bench_model.epoch(
		input = queried + chosen,
		target = time,
		config = chosen
	)

	bench_model.save()
	knob_model.save()
}
