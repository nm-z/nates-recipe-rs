system
	hierarchy:
		Nodes
			Master
				Device
			Worker[s]
				Device[s]
		Machine[s]
			engi
			archy
			sentry
		Device[s]
			VRAM	(GPU )
			RAM	(CPU )
			DISK	(DISK)
	properties:
		ETH
			1GbE:		0.125	GB/s
		DISK
			SIZE:		1000	GB
			SATA III:	0.6	GB/s
		GPU
			VRAM:		12	GB
			PCIe 3.0:	16	GB/s
			FLOPs:	380	GFLOP/s
			Transfer:	432	GB/s
		CPU
			RAM:		48	GB
			DDR5:		90	GB/s
			FLOPs:	150	GFLOP/s
			Transfer:	90	GB/s
	runtime:
		transport:
			directions
				Master	<-eth/wlan->	Worker[s]
				DISK		<-SATA/SAS->	RAM
				RAM		  <-PCIe->		VRAM
			concurrency
				bidirectional
					PCIe	(SDMA)
					NVMe	(PCIe SQ/CQ)
					SAS	(Full duplex)
					eth	(Full duplex)
				unidirectional
					SATA	(Half duplex)
					wlan	(Half duplex)
		ops
			calcs
				in-place
				scalar
			transfers
				async
				sync
		run
			init
			loop
			exit
		lifecycle
			run
				ops
				ops
				...
			run
				ops
				ops
				...
			...
		design:
			AI, DL, ML
