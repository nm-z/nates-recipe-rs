pkgname=recipe
pkgdesc="WIP DO NOT INSTALL - ML/DL/AI training+inference for AMD/NVIDIA GPUs (fp64)"
pkgver=0.0.r$(git rev-list --count HEAD).$(git rev-parse --short HEAD)
pkgrel=1
url=https://github.com/nm-z/nates-recipe-rs
arch=(x86_64)
depends=(rust hip-runtime-amd hipblas hipsolver gcc-libs xz bzip2)
makedepends=(cargo hip-runtime-amd)
options=(!debug !lto)

pkgver() {
    cd nates-recipe-rs
    printf "0.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    ln -sfT "$startdir/.." "$srcdir/nates-recipe-rs"
}

build() {
    cd nates-recipe-rs
    unset RUSTFLAGS DEBUG_RUSTFLAGS CFLAGS CXXFLAGS LDFLAGS
    cargo build --release --workspace
    cargo build --release -p ogdl
}

package() {
    cd nates-recipe-rs
    install -Dm755 target/release/recipe "$pkgdir/usr/bin/recipe"
    install -d "$pkgdir/usr/lib/recipe"
    install -d "$pkgdir/usr/lib/recipe/deps"
    install -m644 target/release/librecipe.rlib "$pkgdir/usr/lib/recipe/"
    install -m644 target/release/libogdl.rlib "$pkgdir/usr/lib/recipe/"
    install -m644 target/release/libgpu_core.rlib "$pkgdir/usr/lib/recipe/"
    install -m644 target/release/libpantry.rlib "$pkgdir/usr/lib/recipe/"
    install -m644 target/release/librecipe_infer.rlib "$pkgdir/usr/lib/recipe/"
    install -m644 target/release/deps/lib*.rlib "$pkgdir/usr/lib/recipe/deps/"
    install -m644 target/release/deps/lib*.so "$pkgdir/usr/lib/recipe/deps/"
}
