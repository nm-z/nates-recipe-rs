[Unit]
Description=recipe RPC daemon
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/recipe serve
Restart=always
RestartSec=2
DynamicUser=yes
SupplementaryGroups=video render
StateDirectory=recipe
CacheDirectory=recipe
Environment=HOME=/var/lib/recipe
Environment=XDG_CONFIG_HOME=/var/lib/recipe
Environment=XDG_CACHE_HOME=/var/cache/recipe

[Install]
WantedBy=multi-user.target
